# cline-pass-switcher 环境变量
# 复制为 .env 后按需修改（.env 已在 .gitignore 中排除）

# 下游代理密钥：new-api 侧渠道的 Key 填同一个值。
# 留空 = 代理面放行、管理面仅回环可访问；对外部署或同机容器对接时务必设置。
PROXY_KEY=

# 上游 Cline Pass API Key（可选，首次启动时自动创建名为 env-account 的账号）
CLINE_PASS_KEY=

# 公网代理地址，用于控制台展示给客户端复制（可选）
PUBLIC_BASE_URL=

# 监听设置：容器内必须 0.0.0.0；本机自用建议 127.0.0.1
BIND_HOST=0.0.0.0
PORT=3123

# 配置目录（容器内固定 /data）
DATA_DIR=/data

# Docker 网络名：本服务创建/加入的网络。
# 若要直接与 new-api 互通，填 new-api 的实际网络名（docker network ls 查看）；
# 留空则使用默认的 cline-pass-net，之后用 docker network connect 把本容器接入 new-api 网络。
NET_NAME=
