# cline-pass-switcher 环境变量
# 复制为 .env 后按需修改（.env 已在 .gitignore 中排除）

# 下游代理密钥：new-api 侧渠道的 Key 填同一个值。
# 留空 = 代理面放行、管理面仅回环可访问；对外部署或同机容器对接时务必设置。
PROXY_KEY=

# 上游 Cline Pass API Key（可选，首次启动时自动创建名为 env-account 的账号）
CLINE_PASS_KEY=

# 公网代理地址，用于控制台展示给客户端复制（可选）
PUBLIC_BASE_URL=

# 监听设置：容器内必须 0.0.0.0；本机自用建议 127.0.0.1
BIND_HOST=0.0.0.0
PORT=3123

# 配置目录（容器内固定 /data）
DATA_DIR=/data

# Docker 网络名：本服务需加入 new-api / cliproxyapi 所在的网络。
# 默认 cliproxyapi_default；若你的环境网络名不同，用 docker network ls 确认后填在这里。
# 注意：该网络会被声明为 external，填错或不存在时 compose 启动会直接报错中止。
NET_NAME=cliproxyapi_default
